{
  "name": "omp-pstack",
  "version": "0.3.3",
  "description": "pstack skills, Poteto Mode, and bundled agents for omp (oh-my-pi). omp-only fork of @casualjim/pi-pstack.",
  "license": "MIT",
  "author": "SenCha930511",
  "contributors": [
    "Lauren Tan",
    "casualjim"
  ],
  "keywords": [
    "omp",
    "oh-my-pi",
    "pi-package",
    "skills",
    "pstack",
    "poteto",
    "subagent"
  ],
  "type": "module",
  "files": [
    "extensions/",
    "skills/",
    "!skills/statechart/scripts/test/**",
    "!skills/**/*.test.ts",
    "agents/",
    "AGENT-INSTALL.md",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SenCha930511/omp-pstack.git"
  },
  "homepage": "https://github.com/SenCha930511/omp-pstack#readme",
  "bugs": {
    "url": "https://github.com/SenCha930511/omp-pstack/issues"
  },
  "omp": {
    "extensions": [
      "./extensions/pstack"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^19.2.0",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check:versions": "node scripts/check-release-versions.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "docs:check": "node scripts/docs-index.mjs --check",
    "test:docs": "node --test scripts/test-docs.mjs",
    "release:bump": "node scripts/bump-release.mjs",
    "test:skills": "node --test tests/*.test.mjs",
    "test:extension": "bun test tests/extension.test.ts tests/install.test.ts",
    "test:graph": "bun scripts/test-load-graph.ts",
    "test:release-scripts": "node --test scripts/test-check-release-versions.mjs scripts/test-bump-release.mjs scripts/test-verify-release-tarball.mjs",
    "test:sync-script": "node --test scripts/test-sync-upstream.mjs scripts/test-upstream-range.mjs scripts/test-sync-ack.mjs scripts/test-check-upstream.mjs",
    "test:upstream-manifest": "node --test scripts/test-check-upstream.mjs",
    "sync:ack": "node scripts/sync-ack.mjs",
    "test:packed": "node scripts/test-packed.mjs",
    "test:marketplace": "node scripts/test-marketplace.mjs",
    "proof:install": "node scripts/proof-install.mjs",
    "test:proof": "node scripts/verify-install-proof.mjs --discovery",
    "test:proof-script": "node --test scripts/test-install-proof.mjs",
    "test": "npm run test:skills && npm run test:extension",
    "pack:check": "npm pack --dry-run",
    "check": "npm run typecheck && npm run check:versions && npm run check:upstream && npm run docs:check && npm run test:skills && npm run test:docs && npm run test:extension && npm run test:graph && npm run test:release-scripts && npm run test:sync-script && npm run test:proof-script && npm run test:proof && npm run test:packed && npm run test:marketplace",
    "prepublishOnly": "npm run check"
  }
}
